   "source": [
    "## Deney 4: Otomatik Prompt Değerlendirme\n",
    "\n",
    "LLM-as-Judge: Model kendi çıktısını değerlendiriyor."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def otomatik_değerlendir(görev: str, çıktı: str, kriterler: dict) -> dict:\n",
    "    \"\"\"LLM'i hakem olarak kullan.\"\"\"\n",
    "    kriter_metni = '\\n'.join([\n",
    "        f\"- {k} (ağırlık {v['ağırlık']}): {v['açıklama']}\"\n",
    "        for k, v in kriterler.items()\n",
    "    ])\n",
    "    \n",
    "    değerlendirme_promptu = f\"\"\"\n",
    "Aşağıdaki çıktıyı kriterlere göre değerlendir.\n",
    "\n",
    "Görev: {görev}\n",
    "\n",
    "Çıktı: {çıktı}\n",
    "\n",
    "Kriterler:\n",
    "{kriter_metni}\n",
    "\n",
    "Her kriter için 1-5 puan ver.\n",
    "Yanıt formatı (sadece JSON):\n",
    "{{\"puanlar\": {{\"kriter_adı\": {{\"puan\": X, \"gerekçe\": \"kısa açıklama\"}}}}, \"genel\": X.X}}\n",
    "\"\"\"\n",
    "    \n",
    "    yanıt = chat(değerlendirme_promptu, temperature=0)\n",
    "    \n",
    "    try:\n",
    "        temiz = yanıt.strip().strip('```json').strip('```').strip()\n",
    "        return json.loads(temiz)\n",
    "    except:\n",
    "        return {\"ham_yanıt\": yanıt}\n",
    "\n",
    "# Test et\n",
    "görev = \"Müşteri şikayetine empati içeren özür e-postası yaz\"\n",
    "çıktı = \"\"\"Konu: Yaşadığınız deneyim için özür dileriz\n",
    "\n",
    "Sayın Müşterimiz,\n",
    "\n",
    "Maalesef bu sorunu yaşadınız. Siparişiniz gecikmeli gelmiş. \n",
    "İadeleriniz için müşteri hizmetleriyle iletişime geçebilirsiniz.\n",
    "\n",
    "İyi günler.\"\"\"\n",
    "\n",
    "kriterler = {\n",
    "    \"empati\": {\"ağırlık\": 0.4, \"açıklama\": \"Müşterinin hayal kırıklığını gerçekten kabul ediyor mu?\"},\n",
    "    \"netlik\": {\"ağırlık\": 0.3, \"açıklama\": \"Sonraki adım net mi?\"},\n",
    "    \"ton\": {\"ağırlık\": 0.3, \"açıklama\": \"Profesyonel ama sıcak mı?\"}\n",
    "}\n",
    "\n",
    "sonuç = otomatik_değerlendir(görev, çıktı, kriterler)\n",
    "print(json.dumps(sonuç, ensure_ascii=False, indent=2))"
   ]
  }
